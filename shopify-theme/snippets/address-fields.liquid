<div class="form-grid" style="margin-top: 16px;">
  {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
  <div class="form-grid" style="grid-template-columns: 1fr 1fr;">
    <input class="field" type="text" name="address[first_name]" value="{{ form.first_name }}" placeholder="{{ 'customer.first_name' | t }}" autocomplete="given-name">
    <input class="field" type="text" name="address[last_name]" value="{{ form.last_name }}" placeholder="{{ 'customer.last_name' | t }}" autocomplete="family-name">
  </div>
  <input class="field" type="text" name="address[company]" value="{{ form.company }}" placeholder="{{ 'customer.addresses.company' | t }}" autocomplete="organization">
  <input class="field" type="text" name="address[address1]" value="{{ form.address1 }}" placeholder="{{ 'customer.addresses.address1' | t }}" autocomplete="address-line1">
  <input class="field" type="text" name="address[address2]" value="{{ form.address2 }}" placeholder="{{ 'customer.addresses.address2' | t }}" autocomplete="address-line2">
  <div class="form-grid" style="grid-template-columns: 1fr 1fr;">
    <input class="field" type="text" name="address[city]" value="{{ form.city }}" placeholder="{{ 'customer.addresses.city' | t }}" autocomplete="address-level2">
    <input class="field" type="text" name="address[zip]" value="{{ form.zip }}" placeholder="{{ 'customer.addresses.zip' | t }}" autocomplete="postal-code">
  </div>
  <select class="field" name="address[country]" data-default="{{ form.country }}" autocomplete="country">{{ all_country_option_tags }}</select>
  <input class="field" type="text" name="address[province]" value="{{ form.province }}" placeholder="{{ 'customer.addresses.province' | t }}" autocomplete="address-level1">
  <input class="field" type="tel" name="address[phone]" value="{{ form.phone }}" placeholder="{{ 'contact.phone' | t }}" autocomplete="tel">
  <label style="display: flex; gap: 8px; align-items: center; font-size: 14px;">
    {{ form.set_as_default_checkbox }} {{ 'customer.addresses.set_default' | t }}
  </label>
  <div><button type="submit" class="button">{{ 'customer.addresses.save' | t }}</button></div>
</div>
<script>
  document.querySelectorAll('select[data-default]').forEach(function (s) { if (s.dataset.default) s.value = s.dataset.default; });
</script>
