{%- comment -%} Shared cart line list for the cart page and drawer. {%- endcomment -%}
<ul class="cart-items">
  {%- for item in cart.items -%}
    <li class="cart-item">
      <a href="{{ item.url }}" class="cart-item__media">
        {%- if item.image -%}
          {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.title }}
        {%- else -%}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </a>
      <div>
        <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
        <div class="cart-item__meta">
          {%- unless item.product.has_only_default_variant -%}
            {%- for option in item.options_with_values -%}
              {{ option.name }}: {{ option.value }}{% unless forloop.last %} · {% endunless %}
            {%- endfor -%}
          {%- endunless -%}
          {%- for property in item.properties -%}
            {%- unless property.last == blank or property.first contains '_' -%}
              <br>{{ property.first }}: {{ property.last }}
            {%- endunless -%}
          {%- endfor -%}
          {%- if item.selling_plan_allocation -%}
            <br>{{ item.selling_plan_allocation.selling_plan.name }}
          {%- endif -%}
        </div>
        <div class="quantity">
          <button type="button" data-qty="minus" aria-label="{{ 'cart.decrease' | t }}">&minus;</button>
          <input type="number" min="0" value="{{ item.quantity }}" data-line-qty="{{ forloop.index }}" aria-label="{{ 'cart.quantity' | t }}">
          <button type="button" data-qty="plus" aria-label="{{ 'cart.increase' | t }}">+</button>
        </div>
      </div>
      <div class="cart-item__right">
        <div class="price">
          {%- if item.original_line_price > item.final_line_price -%}
            <s class="price__compare">{{ item.original_line_price | money }}</s>
          {%- endif -%}
          <span>{{ item.final_line_price | money }}</span>
        </div>
        <a href="{{ item.url_to_remove }}" class="cart-item__remove" data-line-remove="{{ forloop.index }}">{{ 'cart.remove' | t }}</a>
      </div>
    </li>
  {%- endfor -%}
</ul>
