<section class="section" style="--section-pt: 0px; --section-pb: 96px;">
  <div class="page-width">
    <div class="collection-hero">
      <h1 class="h0">{{ section.settings.heading }}</h1>
    </div>
    <div class="collection-tiles" style="--cols: 3; --tile-ratio: 3 / 4;">
      {%- for collection in collections -%}
        {%- if collection.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
        <a href="{{ collection.url }}" class="collection-tile reveal">
          <div class="media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200', sizes: '(min-width: 750px) 33vw, 100vw', alt: collection.title }}
            {%- else -%}
              {%- assign n = forloop.index0 | modulo: 6 | plus: 1 -%}
              {{ 'collection-' | append: n | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="collection-tile__info">
            <div>
              <h2 class="h3">{{ collection.title }}</h2>
              <span style="opacity:.8; font-size: 14px;">{{ 'collections.products_count' | t: count: collection.products_count }}</span>
            </div>
            <span class="collection-tile__arrow">{% render 'icon', name: 'arrow-up-right' %}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>#shopify-section-{{ section.id }} .collection-tile__arrow svg { width: 18px; height: 18px; }</style>

{% schema %}
{
  "name": "Lista de colecciones",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Colecciones" }
  ]
}
{% endschema %}
