{%- liquid
  assign s = section.settings
  assign wordmark = s.wordmark | default: shop.name
-%}
<footer class="footer scheme-dark">
  <div class="page-width">
    <div class="footer__main">
      <div class="footer__newsletter">
        {%- if s.newsletter_heading != blank -%}
          <h2 class="h3">{{ s.newsletter_heading }}</h2>
        {%- endif -%}
        {%- if s.show_newsletter -%}
          {%- form 'customer', id: 'FooterNewsletter' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="form-message" style="background: rgba(255,255,255,.08);">{{ 'newsletter.success' | t }}</p>
            {%- endif -%}
            {%- if form.errors -%}
              <p class="form-message form-message--error" style="background: rgba(255,255,255,.08);">{{ form.errors | default_errors }}</p>
            {%- endif -%}
            <div class="newsletter-form">
              <input type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}" aria-label="{{ 'newsletter.placeholder' | t }}">
              <button type="submit">{{ 'newsletter.submit' | t }}</button>
            </div>
          {%- endform -%}
        {%- endif -%}
        {%- if s.newsletter_text != blank -%}
          <div class="muted">{{ s.newsletter_text }}</div>
        {%- endif -%}
        {%- if s.show_social -%}
          <div class="footer__social">
            {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
            {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
            {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>{%- endif -%}
            {%- if settings.social_x != blank -%}<a href="{{ settings.social_x }}" target="_blank" rel="noopener" aria-label="X">{% render 'icon', name: 'x' %}</a>{%- endif -%}
            {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="footer__menus">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            <h3 class="footer__menu-title">{{ block.settings.title | default: block.settings.menu.title }}</h3>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="footer__bottom">
      <span class="muted">© {{ 'now' | date: '%Y' }} {{ shop.name }}{% if s.copyright != blank %} — {{ s.copyright }}{% endif %}</span>
      {%- if s.show_payments -%}
        <ul class="footer__payments">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>

  {%- if s.show_wordmark -%}
    <div class="footer__wordmark" style="background: {{ s.wordmark_bg }}; color: {{ s.wordmark_color }}; --wordmark-size: {{ s.wordmark_size }}vw;" aria-hidden="true">
      <span>{{ wordmark }}{% if s.wordmark_registered %}®{% endif %}</span>
    </div>
  {%- endif -%}
</footer>

{% schema %}
{
  "name": "Pie de página",
  "class": "section-footer",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Newsletter" },
    { "type": "text", "id": "newsletter_heading", "label": "Título", "default": "Únete al movimiento" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Mostrar formulario", "default": true },
    { "type": "richtext", "id": "newsletter_text", "label": "Texto", "default": "<p>Al suscribirte serás el primero en enterarte de lanzamientos y ofertas. Puedes darte de baja cuando quieras.</p>" },
    { "type": "checkbox", "id": "show_social", "label": "Mostrar redes sociales", "info": "Configura los enlaces en Configuración del tema > Redes sociales.", "default": true },
    { "type": "header", "content": "Parte inferior" },
    { "type": "text", "id": "copyright", "label": "Texto de copyright adicional" },
    { "type": "checkbox", "id": "show_payments", "label": "Mostrar iconos de pago", "default": true },
    { "type": "header", "content": "Logotipo gigante" },
    { "type": "checkbox", "id": "show_wordmark", "label": "Mostrar logotipo gigante", "default": true },
    { "type": "text", "id": "wordmark", "label": "Texto", "info": "Por defecto, el nombre de la tienda." },
    { "type": "checkbox", "id": "wordmark_registered", "label": "Añadir ®", "default": true },
    { "type": "range", "id": "wordmark_size", "label": "Tamaño", "min": 8, "max": 40, "step": 1, "unit": "vw", "default": 22 },
    { "type": "color", "id": "wordmark_bg", "label": "Color de fondo", "default": "#D2FF1F" },
    { "type": "color", "id": "wordmark_color", "label": "Color del texto", "default": "#030607" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menú",
      "settings": [
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "link_list", "id": "menu", "label": "Menú", "default": "footer" }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
