{%- liquid
  assign s = section.settings
  assign align = 'center'
  if s.alignment == 'left'
    assign align = 'start'
  endif
-%}
<section class="section scheme-{{ s.scheme }}" style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px;">
  <div class="page-width rich-text reveal" style="--align: {{ align }}; --text-align: {{ s.alignment }};">
    {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="{{ s.heading_size }}">{{ s.heading | newline_to_br }}</h2>{%- endif -%}
    {%- if s.text != blank -%}<div class="rich-text__text rte">{{ s.text }}</div>{%- endif -%}
    {%- if s.button_label != blank -%}
      <a href="{{ s.button_link | default: routes.all_products_collection_url }}" class="button{% if s.scheme == 'dark' %} button--accent{% endif %}">{{ s.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Texto destacado",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo" },
    { "type": "textarea", "id": "heading", "label": "Título", "default": "Básicos que se mueven contigo." },
    { "type": "select", "id": "heading_size", "label": "Tamaño del título", "options": [{ "value": "h2", "label": "Mediano" }, { "value": "h1", "label": "Grande" }, { "value": "h0", "label": "Enorme" }], "default": "h1" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Sin relleno, solo función. Cuéntale a tus clientes lo que hace única a tu marca.</p>" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Comprar" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "select", "id": "alignment", "label": "Alineación", "options": [{ "value": "center", "label": "Centrado" }, { "value": "left", "label": "Izquierda" }], "default": "center" },
    { "type": "select", "id": "scheme", "label": "Colores", "options": [{ "value": "light", "label": "Claro" }, { "value": "surface", "label": "Gris claro" }, { "value": "dark", "label": "Oscuro" }, { "value": "accent", "label": "Acento" }], "default": "light" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 120 }
  ],
  "presets": [{ "name": "Texto destacado" }]
}
{% endschema %}
