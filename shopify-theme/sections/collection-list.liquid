{%- liquid
  assign s = section.settings
-%}
<section class="section scheme-{{ s.scheme }}" style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px;">
  <div class="page-width">
    {%- if s.heading != blank or s.eyebrow != blank -%}
      <div class="section-head reveal">
        <div class="section-head__titles">
          {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading }}</h2>{%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="collection-tiles" style="--cols: {{ section.blocks.size | at_most: s.columns | at_least: 1 }}; --tile-ratio: {{ s.ratio }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign img = block.settings.image | default: c.featured_image
          assign title = block.settings.title | default: c.title | default: 'Colección'
        -%}
        <a href="{{ c.url | default: routes.all_products_collection_url }}" class="collection-tile reveal" style="transition-delay: {{ forloop.index0 | times: 100 }}ms;" {{ block.shopify_attributes }}>
          <div class="media">
            {%- if img -%}
              {{ img | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500, 800, 1100, 1400', sizes: '(min-width: 750px) 33vw, 100vw', alt: title }}
            {%- else -%}
              {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="collection-tile__info">
            <div>
              <h3 class="h3">{{ title }}</h3>
              {%- if c != blank and s.show_count -%}<span style="opacity:.8; font-size: 14px;">{{ 'collections.products_count' | t: count: c.products_count }}</span>{%- endif -%}
            </div>
            <span class="collection-tile__arrow">{% render 'icon', name: 'arrow-up-right' %}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>#shopify-section-{{ section.id }} .collection-tile__arrow svg { width: 18px; height: 18px; }</style>

{% schema %}
{
  "name": "Lista de colecciones",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Categorías" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Elige tu estilo" },
    { "type": "range", "id": "columns", "label": "Columnas", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "select", "id": "ratio", "label": "Proporción", "options": [{ "value": "1 / 1", "label": "Cuadrada" }, { "value": "3 / 4", "label": "Vertical" }, { "value": "4 / 3", "label": "Horizontal" }], "default": "3 / 4" },
    { "type": "checkbox", "id": "show_count", "label": "Mostrar número de productos", "default": true },
    { "type": "select", "id": "scheme", "label": "Colores", "options": [{ "value": "light", "label": "Claro" }, { "value": "surface", "label": "Gris claro" }, { "value": "dark", "label": "Oscuro" }], "default": "light" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Colección",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "text", "id": "title", "label": "Título personalizado" },
        { "type": "image_picker", "id": "image", "label": "Imagen personalizada" }
      ]
    }
  ],
  "presets": [{
    "name": "Lista de colecciones",
    "blocks": [
      { "type": "collection", "settings": { "title": "Mujer" } },
      { "type": "collection", "settings": { "title": "Hombre" } },
      { "type": "collection", "settings": { "title": "Novedades" } }
    ]
  }]
}
{% endschema %}
