<aside class="cart-drawer" id="CartDrawer" aria-hidden="true" aria-label="{{ 'cart.title' | t }}">
  <div class="cart-drawer__inner" data-cart-drawer-inner style="display: contents;">
    <div class="cart-drawer__head">
      <h2>{{ 'cart.title' | t }} ({{ cart.item_count }})</h2>
      <button type="button" class="icon-button" data-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer__body">
        {% render 'cart-items' %}
      </div>
      <div class="cart-drawer__foot">
        <div class="cart-summary__row cart-summary__total">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money_with_currency }}</span>
        </div>
        <p class="cart-drawer__note">{{ 'cart.taxes_note' | t }}</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="button button--full">{{ 'cart.checkout' | t }}</button>
        </form>
        <a href="{{ routes.cart_url }}" class="button button--outline button--full">{{ 'cart.view_cart' | t }}</a>
      </div>
    {%- else -%}
      <div class="cart-drawer__body">
        <div class="cart-drawer__empty">
          <p class="h3">{{ 'cart.empty' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'cart.continue' | t }}</a>
        </div>
      </div>
    {%- endif -%}
  </div>
</aside>

{% schema %}
{
  "name": "Carrito lateral",
  "settings": []
}
{% endschema %}
