<section class="section" style="--section-pt: 0px; --section-pb: 96px;">
  <div class="page-width">
    <div class="collection-hero">
      <h1 class="h0">{{ blog.title }}</h1>
    </div>
    {%- paginate blog.articles by 9 -%}
      <div class="article-grid">
        {%- for article in blog.articles -%}
          <article class="article-card reveal">
            <div class="media">
              {%- if article.image -%}
                {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, (min-width: 550px) 50vw, 100vw', alt: article.image.alt | default: article.title }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <span class="article-card__meta">{{ article.published_at | time_tag: format: 'date' }}</span>
            <h2 class="article-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            {%- if section.settings.show_excerpt -%}
              <p class="muted">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Artículos del blog",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_excerpt", "label": "Mostrar extracto", "default": true }
  ]
}
{% endschema %}
