{%- liquid
  assign s = section.settings
  assign collection = s.collection
-%}
<section class="section scheme-{{ s.scheme }}" style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px;">
  <div class="page-width">
    <div class="section-head reveal">
      <div class="section-head__titles">
        {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading }}</h2>{%- endif -%}
      </div>
      {%- if s.text != blank -%}<div class="section-head__text muted">{{ s.text }}</div>{%- endif -%}
      {%- if s.show_view_all and collection != blank -%}
        <a href="{{ collection.url }}" class="button button--outline">{{ s.view_all_label }}</a>
      {%- endif -%}
    </div>

    <ul class="product-grid{% if s.layout == 'slider' %} product-grid--slider{% endif %}" style="--cols: {{ s.columns }}; --cols-tablet: {% if s.columns > 3 %}3{% else %}{{ s.columns }}{% endif %}; --card-ratio: {{ s.image_ratio }};">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: s.limit -%}
          <li class="reveal" style="transition-delay: {{ forloop.index0 | modulo: 4 | times: 80 }}ms;">
            {% render 'product-card', product: product, show_vendor: s.show_vendor, image_fit: s.image_fit %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..s.limit) limit: 8 -%}
          <li>
            <div class="card">
              {%- assign placeholder_index = forloop.index0 | modulo: 4 | plus: 1 -%}
              {%- assign placeholder = 'product-apparel-' | append: placeholder_index -%}
              <div class="card__media">{{ placeholder | placeholder_svg_tag: 'placeholder-svg' }}</div>
              <div class="card__info">
                <h3 class="card__title">{{ 'products.product.placeholder_title' | t }}</h3>
                <div class="price">{{ 7999 | money }}</div>
              </div>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Colección destacada",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Lo más vendido" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Pisa fuerte" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "limit", "label": "Número de productos", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columnas en escritorio", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "layout", "label": "Diseño", "options": [{ "value": "grid", "label": "Cuadrícula" }, { "value": "slider", "label": "Carrusel horizontal" }], "default": "grid" },
    { "type": "select", "id": "image_ratio", "label": "Proporción de imagen", "options": [{ "value": "1 / 1", "label": "Cuadrada" }, { "value": "4 / 5", "label": "Vertical" }, { "value": "3 / 4", "label": "Vertical alta" }], "default": "4 / 5" },
    { "type": "select", "id": "image_fit", "label": "Encaje de imagen", "options": [{ "value": "cover", "label": "Rellenar" }, { "value": "contain", "label": "Ajustar (ideal para fotos con fondo)" }], "default": "cover" },
    { "type": "checkbox", "id": "show_vendor", "label": "Mostrar marca", "default": false },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostrar botón \"Ver todo\"", "default": true },
    { "type": "text", "id": "view_all_label", "label": "Texto \"Ver todo\"", "default": "Ver todo" },
    { "type": "select", "id": "scheme", "label": "Colores", "options": [{ "value": "light", "label": "Claro" }, { "value": "surface", "label": "Gris claro" }, { "value": "dark", "label": "Oscuro" }], "default": "light" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [{ "name": "Colección destacada" }]
}
{% endschema %}
