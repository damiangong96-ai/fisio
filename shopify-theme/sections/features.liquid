{%- liquid
  assign s = section.settings
-%}
<section class="section scheme-{{ s.scheme }}" style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px;">
  <div class="page-width">
    {%- if s.heading != blank -%}
      <div class="section-head reveal"><h2 class="h2">{{ s.heading }}</h2></div>
    {%- endif -%}
    <div class="features">
      {%- for block in section.blocks -%}
        <div class="feature reveal" style="transition-delay: {{ forloop.index0 | times: 80 }}ms;" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon %}
          <div class="feature__text">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ventajas",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título" },
    { "type": "select", "id": "scheme", "label": "Colores", "options": [{ "value": "dark", "label": "Oscuro" }, { "value": "light", "label": "Claro" }, { "value": "surface", "label": "Gris claro" }], "default": "dark" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Ventaja",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icono", "options": [
          { "value": "leaf", "label": "Hoja" },
          { "value": "box", "label": "Caja" },
          { "value": "shield", "label": "Escudo" },
          { "value": "return", "label": "Devolución" },
          { "value": "truck", "label": "Camión" },
          { "value": "globe", "label": "Mundo" },
          { "value": "heart", "label": "Corazón" },
          { "value": "star", "label": "Estrella" }
        ], "default": "leaf" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Embalaje 100% reciclado." }
      ]
    }
  ],
  "presets": [{
    "name": "Ventajas",
    "blocks": [
      { "type": "feature", "settings": { "icon": "leaf", "text": "Embalaje y papel certificados FSC®." } },
      { "type": "feature", "settings": { "icon": "box", "text": "Pedidos enviados en 1–2 días con seguimiento." } },
      { "type": "feature", "settings": { "icon": "shield", "text": "Materiales duraderos que mantienen la forma." } },
      { "type": "feature", "settings": { "icon": "return", "text": "30 días para cambios o devoluciones." } }
    ]
  }]
}
{% endschema %}
