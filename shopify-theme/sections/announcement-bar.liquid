{%- if section.settings.text != blank -%}
  <div class="announcement" style="background: {{ section.settings.color_bg }}; color: {{ section.settings.color_text }};">
    <div class="page-width announcement__inner">
      <span class="announcement__text">{{ section.settings.text }}</span>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: routes.all_products_collection_url }}" class="announcement__link">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncios",
  "class": "section-announcement",
  "settings": [
    { "type": "text", "id": "text", "label": "Texto", "default": "Descuentos para nuevos clientes hasta la próxima semana." },
    { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Ver ahora" },
    { "type": "url", "id": "link", "label": "Enlace" },
    { "type": "color", "id": "color_bg", "label": "Color de fondo", "default": "#491EFF" },
    { "type": "color", "id": "color_text", "label": "Color del texto", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Barra de anuncios" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
