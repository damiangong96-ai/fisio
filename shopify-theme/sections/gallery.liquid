{%- liquid
  assign s = section.settings
-%}
<section class="section scheme-{{ s.scheme }}" style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px;">
  <div class="page-width">
    <div class="section-head reveal">
      <div class="section-head__titles">
        {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading }}</h2>{%- endif -%}
      </div>
      {%- if s.link_label != blank -%}
        <a href="{{ s.link | default: '#' }}" class="button button--outline" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %} {{ s.link_label }}</a>
      {%- endif -%}
    </div>
    <div class="gallery" style="--cols: {{ s.columns }};">
      {%- for block in section.blocks -%}
        {%- capture media -%}
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 750px) 16vw, 33vw', alt: block.settings.image.alt }}
          {%- else -%}
            {%- assign n = forloop.index0 | modulo: 2 | plus: 1 -%}
            {{ 'lifestyle-' | append: n | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        {%- endcapture -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="gallery__item reveal" style="transition-delay: {{ forloop.index0 | times: 60 }}ms;" {{ block.shopify_attributes }}>{{ media }}</a>
        {%- else -%}
          <div class="gallery__item reveal" style="transition-delay: {{ forloop.index0 | times: 60 }}ms;" {{ block.shopify_attributes }}>{{ media }}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
<style>#shopify-section-{{ section.id }} .button svg { width: 18px; height: 18px; }</style>

{% schema %}
{
  "name": "Galería / Instagram",
  "tag": "div",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Comunidad" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Síguenos en Instagram" },
    { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "@mitienda" },
    { "type": "url", "id": "link", "label": "Enlace" },
    { "type": "range", "id": "columns", "label": "Columnas en escritorio", "min": 3, "max": 8, "step": 1, "default": 6 },
    { "type": "select", "id": "scheme", "label": "Colores", "options": [{ "value": "light", "label": "Claro" }, { "value": "surface", "label": "Gris claro" }, { "value": "dark", "label": "Oscuro" }], "default": "light" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Imagen",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [{
    "name": "Galería / Instagram",
    "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }]
  }]
}
{% endschema %}
