<section class="scheme-dark" style="min-height: 100vh; display: flex; flex-direction: column;">
  <div class="page-width" style="flex: 1; display: grid; align-content: center; gap: 28px; padding-top: 64px; padding-bottom: 64px;">
    <span class="eyebrow">{{ 'password.coming_soon' | t }}</span>
    <h1 class="h0">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}<p style="max-width: 520px; font-size: 18px; opacity: .8;">{{ shop.password_message }}</p>{%- endif -%}
    <div style="max-width: 520px;">
      {%- form 'customer' -%}
        <input type="hidden" name="contact[tags]" value="prospect,password page">
        {%- if form.posted_successfully? -%}<p class="form-message" style="background: rgba(255,255,255,.08);">{{ 'newsletter.success' | t }}</p>{%- endif -%}
        <div class="newsletter-form">
          <input type="email" name="contact[email]" required placeholder="{{ 'newsletter.placeholder' | t }}" aria-label="{{ 'newsletter.placeholder' | t }}">
          <button type="submit">{{ 'newsletter.submit' | t }}</button>
        </div>
      {%- endform -%}
    </div>
    <details style="max-width: 520px;">
      <summary style="cursor: pointer; opacity: .7;">{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password', class: 'form-grid' -%}
        {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div style="display: flex; gap: 8px; margin-top: 12px;">
          <input class="field" type="password" name="password" placeholder="{{ 'customer.password' | t }}" style="color: var(--color-ink);">
          <button type="submit" class="button button--accent">{{ 'password.submit' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
  <div class="footer__wordmark" aria-hidden="true"><span>{{ shop.name }}</span></div>
</section>
