{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_card.title' | t }} — {{ shop.name }}</title>
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body>
    <main class="page-width" style="max-width: 560px; padding-top: 64px; padding-bottom: 64px; display: grid; gap: 24px; text-align: center; justify-items: center;">
      <span class="header__logo-text">{{ shop.name }}</span>
      <div class="cart-summary" style="position: static; width: 100%; justify-items: center;">
        <span class="eyebrow">{{ 'gift_card.title' | t }}</span>
        <p class="h1">{{ gift_card.balance | money }}</p>
        {%- if gift_card.enabled == false or gift_card.expired -%}
          <span class="badge badge--sale">{{ 'gift_card.expired' | t }}</span>
        {%- endif -%}
        <p><strong style="font-size: 22px; letter-spacing: .1em;">{{ gift_card.code | format_code }}</strong></p>
        <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
      </div>
      <a href="{{ shop.url }}" class="button">{{ 'cart.continue' | t }}</a>
      <button type="button" class="button button--outline" onclick="window.print();">{{ 'gift_card.print' | t }}</button>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
