<section class="section" style="--section-pt: 64px; --section-pb: 120px;">
  <div class="page-width auth">
    <h1 class="h1">{{ 'customer.reset.title' | t }}</h1>
    {%- form 'reset_customer_password', class: 'form-grid' -%}
      {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
      <input class="field" type="password" name="customer[password]" autocomplete="new-password" placeholder="{{ 'customer.password' | t }}" required>
      <input class="field" type="password" name="customer[password_confirmation]" autocomplete="new-password" placeholder="{{ 'customer.password_confirm' | t }}" required>
      <button type="submit" class="button button--full">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
