<section class="section" style="--section-pt: 48px; --section-pb: 120px;">
  <div class="page-width">
    <div class="collection-hero">
      <a href="{{ routes.account_url }}" class="eyebrow">{{ 'customer.account.title' | t }}</a>
      <h1 class="h1">{{ 'customer.orders.order' | t }} {{ order.name }}</h1>
      <p class="muted">{{ order.created_at | time_tag: format: 'date_at_time' }}</p>
      {%- if order.cancelled -%}<p class="form-message form-message--error">{{ 'customer.orders.cancelled' | t }}</p>{%- endif -%}
    </div>
    <div class="cart-page">
      <ul class="cart-items">
        {%- for line_item in order.line_items -%}
          <li class="cart-item">
            <div class="cart-item__media">{% if line_item.image %}{{ line_item.image | image_url: width: 240 | image_tag: loading: 'lazy' }}{% endif %}</div>
            <div>
              <div class="cart-item__title">{{ line_item.title }}</div>
              <div class="cart-item__meta">× {{ line_item.quantity }}{% if line_item.fulfillment %} · {{ line_item.fulfillment.tracking_company }} {{ line_item.fulfillment.tracking_number }}{% endif %}</div>
            </div>
            <div class="price">{{ line_item.final_line_price | money }}</div>
          </li>
        {%- endfor -%}
      </ul>
      <aside class="cart-summary">
        <div class="cart-summary__row"><span>{{ 'cart.subtotal' | t }}</span><span>{{ order.line_items_subtotal_price | money }}</span></div>
        {%- for shipping_method in order.shipping_methods -%}
          <div class="cart-summary__row"><span>{{ shipping_method.title }}</span><span>{{ shipping_method.price | money }}</span></div>
        {%- endfor -%}
        {%- for tax_line in order.tax_lines -%}
          <div class="cart-summary__row"><span>{{ tax_line.title }} ({{ tax_line.rate_percentage }}%)</span><span>{{ tax_line.price | money }}</span></div>
        {%- endfor -%}
        <div class="cart-summary__row cart-summary__total"><span>{{ 'customer.orders.total' | t }}</span><span>{{ order.total_price | money_with_currency }}</span></div>
        {%- if order.shipping_address -%}
          <div style="font-size: 14px;"><strong>{{ 'customer.orders.shipping_address' | t }}</strong><br>{{ order.shipping_address | format_address }}</div>
        {%- endif -%}
      </aside>
    </div>
  </div>
</section>
