<section class="section" style="--section-pt: 48px; --section-pb: 120px;">
  <div class="page-width">
    <div class="collection-hero">
      <h1 class="h1">{{ 'customer.account.title' | t }}</h1>
      <p class="muted">{{ customer.first_name }} {{ customer.last_name }} · {{ customer.email }}</p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="{{ routes.account_addresses_url }}" class="button button--outline">{{ 'customer.addresses.title' | t }} ({{ customer.addresses_count }})</a>
        <a href="{{ routes.account_logout_url }}" class="button button--outline">{{ 'customer.account.logout' | t }}</a>
      </div>
    </div>
    <h2 class="h3" style="margin: 32px 0 16px;">{{ 'customer.orders.title' | t }}</h2>
    {%- paginate customer.orders by 20 -%}
      {%- if customer.orders.size > 0 -%}
        <div style="overflow-x: auto;">
          <table class="account-table">
            <thead><tr><th>{{ 'customer.orders.order' | t }}</th><th>{{ 'customer.orders.date' | t }}</th><th>{{ 'customer.orders.payment' | t }}</th><th>{{ 'customer.orders.fulfillment' | t }}</th><th>{{ 'customer.orders.total' | t }}</th></tr></thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a href="{{ order.customer_url }}" style="text-decoration: underline;">{{ order.name }}</a></td>
                  <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_price | money_with_currency }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      {%- else -%}
        <p class="muted">{{ 'customer.orders.none' | t }}</p>
      {%- endif -%}
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>
