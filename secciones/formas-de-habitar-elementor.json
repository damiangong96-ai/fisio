              "settings": {
                "html": "<style>\n  .fdh-section.fdh-section{\n    --fdh-bg: #efe8db;\n    --fdh-ink: #2b2620;\n    --fdh-border: #35302a;\n    --fdh-muted: #55503f;\n    --fdh-font-serif: 'Cormorant Garamond', 'Playfair Display', Georgia, serif;\n    --fdh-font-script: 'Playfair Display', Georgia, serif;\n    --fdh-font-body: 'Inter', 'Helvetica Neue', Arial, sans-serif;\n\n    background: var(--fdh-bg) !important;\n    color: var(--fdh-ink) !important;\n    font-family: var(--fdh-font-body) !important;\n    padding: clamp(32px, 6vw, 64px) clamp(16px, 6vw, 64px) !important;\n    box-sizing: border-box !important;\n  }\n  .fdh-section.fdh-section,\n  .fdh-section.fdh-section *{\n    box-sizing: border-box !important;\n    text-decoration: none !important;\n    list-style: none !important;\n    letter-spacing: normal;\n  }\n\n  .fdh-section .fdh-frame{\n    max-width: 1100px !important;\n    margin: 0 auto !important;\n    border: 1px solid var(--fdh-border) !important;\n    background: var(--fdh-bg) !important;\n  }\n\n  .fdh-section h2.fdh-title{\n    margin: 0 !important;\n    padding: clamp(20px,3vw,32px) 20px !important;\n    text-align: center !important;\n    font-family: var(--fdh-font-serif) !important;\n    font-weight: 500 !important;\n    font-style: normal !important;\n    font-size: clamp(22px, 3.4vw, 34px) !important;\n    letter-spacing: 0.08em !important;\n    text-transform: uppercase !important;\n    border-bottom: 1px solid var(--fdh-border) !important;\n    color: var(--fdh-ink) !important;\n    line-height: 1.3 !important;\n  }\n\n  .fdh-section .fdh-grid__row--content{\n    display: grid !important;\n    grid-template-columns: repeat(2, 1fr) !important;\n    border-bottom: 1px solid var(--fdh-border) !important;\n  }\n  .fdh-section .fdh-grid__row--footer{\n    display: grid !important;\n    grid-template-columns: repeat(2, 1fr) !important;\n  }\n\n  .fdh-section .fdh-card{\n    padding: clamp(28px,4vw,44px) clamp(28px,5vw,56px) clamp(32px,4vw,48px) !important;\n    text-align: center !important;\n    border-right: 1px solid var(--fdh-border) !important;\n    margin: 0 !important;\n  }\n  .fdh-section .fdh-grid__row--content .fdh-card:last-child,\n  .fdh-section .fdh-grid__row--footer .fdh-link:last-child{\n    border-right: none !important;\n  }\n\n  .fdh-section .fdh-card__badge{\n    display: inline-flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    width: 56px !important;\n    height: 32px !important;\n    border: 1px solid var(--fdh-border) !important;\n    border-radius: 50% !important;\n    font-family: var(--fdh-font-body) !important;\n    font-size: 11px !important;\n    font-weight: 600 !important;\n    font-style: normal !important;\n    text-transform: none !important;\n    letter-spacing: 0.03em !important;\n    margin: 0 0 22px !important;\n    color: var(--fdh-ink) !important;\n    background: transparent !important;\n  }\n\n  .fdh-section h3.fdh-card__brand{\n    margin: 0 !important;\n    font-family: var(--fdh-font-serif) !important;\n    font-weight: 700 !important;\n    font-style: normal !important;\n    font-size: clamp(24px, 3vw, 30px) !important;\n    line-height: 1.1 !important;\n    text-transform: none !important;\n    color: var(--fdh-ink) !important;\n  }\n  .fdh-section span.fdh-card__sub{\n    display: block !important;\n    margin-top: 2px !important;\n    font-family: var(--fdh-font-script) !important;\n    font-style: italic !important;\n    font-weight: 400 !important;\n    font-size: clamp(17px, 2.2vw, 21px) !important;\n    text-transform: none !important;\n    color: var(--fdh-ink) !important;\n  }\n\n  .fdh-section .fdh-card__img{\n    display: block !important;\n    width: 168px !important;\n    max-width: 60% !important;\n    aspect-ratio: 3 / 4 !important;\n    object-fit: cover !important;\n    margin: 26px auto 24px !important;\n    background: #d8d2c3 !important;\n    border: 0 !important;\n  }\n  .fdh-section .fdh-card__img[data-placeholder]{\n    display: flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    border: 1px dashed var(--fdh-border) !important;\n    color: var(--fdh-muted) !important;\n    font-family: var(--fdh-font-body) !important;\n    font-size: 11px !important;\n    letter-spacing: 0.04em !important;\n    text-align: center !important;\n    padding: 8px !important;\n  }\n\n  .fdh-section p.fdh-card__text{\n    margin: 0 auto !important;\n    max-width: 32ch !important;\n    font-family: var(--fdh-font-body) !important;\n    font-size: 14.5px !important;\n    font-weight: 400 !important;\n    font-style: normal !important;\n    line-height: 1.7 !important;\n    text-transform: none !important;\n    color: var(--fdh-ink) !important;\n  }\n\n  .fdh-section .fdh-link{\n    padding: 18px 20px !important;\n    text-align: center !important;\n    border-right: 1px solid var(--fdh-border) !important;\n    margin: 0 !important;\n  }\n  .fdh-section .fdh-link a{\n    display: inline-flex !important;\n    align-items: center !important;\n    gap: 10px !important;\n    color: var(--fdh-ink) !important;\n    text-decoration: none !important;\n    text-transform: none !important;\n    font-family: var(--fdh-font-body) !important;\n    font-size: 13px !important;\n    font-weight: 400 !important;\n    letter-spacing: 0.03em !important;\n    border: 0 !important;\n    background: transparent !important;\n  }\n  .fdh-section .fdh-link a .fdh-arrow{\n    display: inline-block !important;\n    transition: transform 0.25s ease !important;\n  }\n  .fdh-section .fdh-link a:hover .fdh-arrow{ transform: translateX(6px) !important; }\n  .fdh-section .fdh-link a:hover{ text-decoration: underline !important; text-underline-offset: 4px !important; }\n\n  @media (max-width: 720px){\n    .fdh-section .fdh-grid__row--content,\n    .fdh-section .fdh-grid__row--footer{ grid-template-columns: 1fr !important; }\n    .fdh-section .fdh-card,\n    .fdh-section .fdh-link{ border-right: none !important; border-bottom: 1px solid var(--fdh-border) !important; }\n    .fdh-section .fdh-grid__row--content .fdh-card:last-child{ border-bottom: none !important; }\n    .fdh-section .fdh-grid__row--footer .fdh-link:last-child{ border-bottom: none !important; }\n  }\n</style>\n\n<section class=\"fdh-section\" aria-label=\"Formas de habitar\">\n  <div class=\"fdh-frame\">\n\n    <h2 class=\"fdh-title\">Formas de habitar [Marca]</h2>\n\n    <div class=\"fdh-grid__row--content\">\n\n      <!-- Tarjeta 1 -->\n      <article class=\"fdh-card\">\n        <span class=\"fdh-card__badge\">01</span>\n        <h3 class=\"fdh-card__brand\">[Marca]<span class=\"fdh-card__sub\">Brands</span></h3>\n\n        <!-- Sustituye este div por: <img src=\"ruta/a/tu-imagen.jpg\" alt=\"...\" class=\"fdh-card__img\"> -->\n        <div class=\"fdh-card__img\" data-placeholder=\"IMAGEN_TARJETA_1\">Imagen 1<br>(sustituir)</div>\n\n        <p class=\"fdh-card__text\">\n          Todas necesitan una razón para existir. En [Marca] descubrimos esa\n          historia y la convertimos en un universo capaz de verse, sentirse\n          y recordarse.\n        </p>\n      </article>\n\n      <!-- Tarjeta 2 -->\n      <article class=\"fdh-card\">\n        <span class=\"fdh-card__badge\">02</span>\n        <h3 class=\"fdh-card__brand\">[Marca]<span class=\"fdh-card__sub\">Experiences</span></h3>\n\n        <!-- Sustituye este div por: <img src=\"ruta/a/tu-imagen.jpg\" alt=\"...\" class=\"fdh-card__img\"> -->\n        <div class=\"fdh-card__img\" data-placeholder=\"IMAGEN_TARJETA_2\">Imagen 2<br>(sustituir)</div>\n\n        <p class=\"fdh-card__text\">\n          Hay historias que necesitan ser vividas. Una boda. Un lanzamiento.\n          Un encuentro. Una experiencia compartida. Creamos universos donde\n          cada detalle ayuda a que ese momento permanezca mucho después de\n          haber terminado.\n        </p>\n      </article>\n\n    </div>\n\n    <div class=\"fdh-grid__row--footer\">\n      <div class=\"fdh-link\"><a href=\"#\">Explorar este universo <span class=\"fdh-arrow\">&#8594;</span></a></div>\n      <div class=\"fdh-link\"><a href=\"#\">Explorar este universo <span class=\"fdh-arrow\">&#8594;</span></a></div>\n    </div>\n\n  </div>\n</section>\n"
              },
